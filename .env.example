# ──────────────────────────────────────────────────────────────
# 프론트엔드 환경변수 (Vite) — 이 파일을 .env 로 복사해 값을 채우세요.
# ⚠️ VITE_ 접두사 값은 브라우저 번들에 포함됩니다. anon(public) 키만 넣으세요.
#     Google/Gemini API 키는 절대 여기 두지 마세요 → Supabase 시크릿(서버)에 보관.
# ──────────────────────────────────────────────────────────────

# '✨ AI로 완성'이 호출할 Supabase Edge Function 위치.
# 비워두면 앱은 내장 오프라인 빌더로 자동 폴백합니다(서버 없이도 동작).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# (선택) 엣지 펑션 이름을 바꿨다면 지정.
# VITE_REFINE_FUNCTION=refine            # 텍스트 프롬프트 다듬기 (기본: refine)
# VITE_GENERATE_FUNCTION=generate-image  # 프롬프트→이미지 생성 (기본: generate-image)
